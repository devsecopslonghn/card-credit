{
  "name": "@card-credit/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src tests scripts",
    "test": "node --import tsx --test tests/*.test.ts",
    "validate": "npm run typecheck && npm run lint && npm test && npm run build",
    "import:catalog": "tsx scripts/import-card-catalog.ts"
  },
  "dependencies": {
    "@card-credit/contracts": "file:../shared",
    "fastify": "^5.6.2",
    "mongoose": "^9.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^20.19.25",
    "eslint": "^9.39.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  }
}
